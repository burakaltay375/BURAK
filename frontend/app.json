{
  "expo": {
    "name": "Hospira",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000"
        }
      ],
      "expo-font",
      "expo-audio",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Tamamlanan işin fotoğrafını çekmek için"
        }
      ],
      "expo-video"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Tamamlanan işin fotoğrafını çekmek için",
        "NSMicrophoneUsageDescription": "Sesli talep oluşturmak için"
      },
      "bundleIdentifier": "com.emergent.hotelopshub.vstlq8"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO"
      ],
      "package": "com.emergent.hotelopshub.vstlq8"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
