# Expo — copy to frontend/.env
# Used in: src/api.ts

# Empty = same-origin /api (Next.js rewrites to FastAPI).
# For a standalone Expo web port, set the backend origin without /api.
EXPO_PUBLIC_BACKEND_URL=

# Optional dev tooling (metro.config.js, scripts/cmd-guard/rules.js)
# METRO_CACHE_ROOT=
# CMD_GUARD_RULES=/opt/install-guard/rules.json
# CMD_GUARD_DEBUG=
