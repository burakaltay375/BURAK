# Next.js — copy to security-website/.env.local
# Used in: lib/panterAdminApi.ts, components/LandingPage.tsx, next.config.ts

# Same-origin /api is rewritten to the FastAPI backend (see next.config.ts).
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_PANTER_API_URL=/api
PANTER_BACKEND_ORIGIN=http://127.0.0.1:18080
