# =============================================================================
# Panter / BURAK — environment variable template (placeholders only)
# =============================================================================
# Copy values into the local file each app reads:
#
#   Backend:          backend/.env
#   Next.js site:     security-website/.env.local
#   Expo mobile app:  frontend/.env
#
# Do not commit real secrets. Use placeholder values below as a starting point.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend — backend/server.py
# -----------------------------------------------------------------------------

MONGO_URL=mongodb://localhost:27017
DB_NAME=hotel_ops
JWT_SECRET=change-me-to-a-long-random-dev-secret
IDENTITY_ENCRYPTION_KEY=
SYSTEM_ADMIN_EMAIL=admin@example.com
SYSTEM_ADMIN_PASSWORD=change-me-strong-password
EMERGENT_LLM_KEY=
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# -----------------------------------------------------------------------------
# security-website (Next.js) — security-website/.env.local
# Used in: lib/panterAdminApi.ts, components/LandingPage.tsx
# -----------------------------------------------------------------------------

NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_PANTER_API_URL=http://localhost:8000/api

# -----------------------------------------------------------------------------
# frontend (Expo) — frontend/.env
# Used in: src/api.ts
# -----------------------------------------------------------------------------

EXPO_PUBLIC_BACKEND_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# frontend (optional dev tooling — not required for normal app runtime)
# Used in: metro.config.js, scripts/cmd-guard/rules.js
# -----------------------------------------------------------------------------

# METRO_CACHE_ROOT=
# CMD_GUARD_RULES=/opt/install-guard/rules.json
# CMD_GUARD_DEBUG=
